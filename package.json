{
  "name": "web-game-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "server": "npm run start --workspace=apps/server",
    "build": "npm run build --workspace=apps/web",
    "install-all": "npm install && npm install --workspace=apps/web && npm install --workspace=apps/server"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}